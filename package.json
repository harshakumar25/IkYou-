{
  "name": "localfingerprint",
  "version": "1.0.0",
  "description": "Local, open-source high-performance OSINT identity investigation & device fingerprinting platform reverse-engineered from fingerprint.to",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "localfingerprint": "bin/localfingerprint.mjs"
